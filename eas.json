{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "sidestore": {
      "ios": {
        "withoutCredentials": true,
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "autoIncrement": false,
        "simulator": false
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    }
  }
}
