{
  "expo": {
    "name": "Everyday Toolbox",
    "slug": "everyday-toolbox",
    "icon": "./assets/icon-v2.png",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "17",
      "supportsTablet": true,
      "bundleIdentifier": "com.alioz.everydaytoolbox",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alioz.everydaytoolbox"
    },
    "extra": {
      "eas": {
        "projectId": "f499c8e1-73a7-45bd-b5a4-9f327307f205"
      }
    },
    "owner": "aliyo",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Everyday Toolbox to save receipt photos to your library.",
          "savePhotosPermission": "Allow Everyday Toolbox to save receipt photos to your library."
        }
      ]
    ]
  }
}
