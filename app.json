{
  "expo": {
    "name": "Everyday Toolbox",
    "slug": "everyday-toolbox",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "3",
      "supportsTablet": true,
      "bundleIdentifier": "com.alioz.everydaytoolbox",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alioz.everydaytoolbox"
    },
    "extra": {
      "eas": {
        "projectId": "f499c8e1-73a7-45bd-b5a4-9f327307f205"
      }
    },
    "owner": "aliyo",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
