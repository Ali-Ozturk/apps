{
  "expo": {
    "name": "Hello World",
    "slug": "hello-world-ios",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.alioz.helloworldios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alioz.helloworldios"
    },
    "extra": {
      "eas": {
        "projectId": "f499c8e1-73a7-45bd-b5a4-9f327307f205"
      }
    },
    "owner": "aliyo",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ]
  }
}
